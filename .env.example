# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Authentication
NEXTAUTH_SECRET=your_nextauth_secret_here

# OAuth Providers
GITHUB_ID=your_github_oauth_id
GITHUB_SECRET=your_github_oauth_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Configuration
# SMTP will be configured in Supabase Dashboard
# For local testing, Supabase provides a test email service

# API Keys
OPENAI_API_KEY=your_openai_api_key

# Lemonsqueezy (Payments)
NEXT_PUBLIC_LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_API_KEY=your_api_key

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_AUTH_TOKEN=your_sentry_token
SENTRY_AUTH_TOKEN=your_sentry_token

# Database (if using external DB)
DATABASE_URL=your_database_url

# Feature Flags
NEXT_PUBLIC_ENABLE_GITHUB_INTEGRATION=true
NEXT_PUBLIC_ENABLE_EMAIL_VERIFICATION=true
